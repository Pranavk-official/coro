# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


## AGENT FILES
.agents/
.claude/
.opencode/
.windsurf/
skills-lock.json
specs/
# env examples are the contract — keep them
!.env.example
!dev/.env.dev.example

# prisma (generated client lives in src/generated, see prisma/schema.prisma)
/src/generated/

# dev tooling
/dev/backups/
*.dump

# graphify
graphify-out/

# mobile app (spec 008): deps; Android/iOS build output is ignored by the generated mobile/android|ios/.gitignore
/mobile/node_modules/
# Gradle cache (also left behind on branches without mobile/android/.gitignore)
.gradle/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/.auth/

# local recordings / media scratch
/recordings/

/src/generated/prisma

# Temp Files
tmp/
brag/