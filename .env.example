# Copy to .env for local dev (never commit real secrets). Every var documented in one line.
DATABASE_URL=postgresql://app:app@localhost:54329/app # Prisma → Postgres (dev compose)
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32 # signs sessions + room join tokens
BETTER_AUTH_URL=http://localhost:3000 # public app URL (OAuth callbacks, OG tags, robots.txt, sitemap; prod compose passes it to the image build)
GOOGLE_CLIENT_ID= # Google OAuth client id (blank = button hidden)
GOOGLE_CLIENT_SECRET= # Google OAuth client secret
GITHUB_CLIENT_ID= # GitHub OAuth client id (blank = button hidden)
GITHUB_CLIENT_SECRET= # GitHub OAuth client secret
AUTH_TEST_LOGIN= # 1 = Playwright only (auto-verifies @test.local sign-ups); server refuses to boot with it in prod
INTERNAL_SECRET=change-me-internal # x-internal-secret for signaling ↔ HTTP internal routes
S3_ENDPOINT=http://localhost:19000 # S3 API endpoint (MinIO dev compose)
S3_REGION=us-east-1 # S3 region (MinIO default)
S3_ACCESS_KEY=minio # MinIO root user (dev)
S3_SECRET_KEY=minio123 # MinIO root password (dev)
S3_BUCKET=vc-demo # bucket for uploads (auto-created on boot)
S3_PUBLIC_ENDPOINT=http://localhost:19000 # browser-reachable endpoint for presigned URLs
TURN_HOST= # coturn host (unset = STUN only)
TURN_SECRET= # coturn REST shared secret
PORT=3000 # server.ts listen port
SMTP_URL=smtp://localhost:11025 # SMTP for auth mail (dev: Mailpit, UI at :18025); unset = mail logged, not sent
MAIL_FROM=Coro <no-reply@localhost> # From header on auth mail
REDIS_URL=redis://localhost:16379 # rate-limit counters + read cache (prod compose: redis://redis:6379); unset = limits + cache off
REDIS_REQUIRED= # 1 = refuse to boot when Redis is unreachable (set in prod); unset = fail open
TRUST_PROXY= # 1 = trust X-Forwarded-For first hop for client IP (only behind your own reverse proxy)
RATE_LIMIT_DISABLED= # 1 = turn every rate limit off (Playwright/dev only; server refuses to boot with it in prod)
RATE_LIMIT_MAIL_DAILY= # global outgoing-mail cap as max/windowSec (default 500/86400); any RATE_LIMIT_<NAME>=max/windowSec overrides a limit (e.g. RATE_LIMIT_ROOMS_VERIFY=5/300)
POSTGRES_PASSWORD=app # prod compose only: db password (DATABASE_URL uses it)
MINIO_ROOT_USER=minio # prod compose only: MinIO root user (S3_ACCESS_KEY uses it)
MINIO_ROOT_PASSWORD=change-me-minio # prod compose only: MinIO root password (S3_SECRET_KEY uses it)
