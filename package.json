{
  "name": "socket.io_vc-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Pranav K (https://github.com/Pranavk-official)",
  "repository": "github:Pranavk-official/coro",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:test": "node --import tsx server.ts",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:int": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e",
    "test:regression": "playwright test --grep @regression",
    "test:uat": "playwright test --project=e2e --grep @uat",
    "screenshots": "SHOWCASE=1 playwright test --project=showcase",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@base-ui/react": "1.8.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hono/vercel": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@internationalized/date": "3.12.4",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "@prisma/client-runtime-utils": "7",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.16",
    "page-mascot": "^0.1.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "redis": "^6.3.0",
    "shiki": "4.5.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
